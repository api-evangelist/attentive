                    "value": "<token>"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phone\": \"+13115552368\",\n  \"email\": \"sample-email@attentivemobile.com\",\n  \"shopifyId\": \"<string>\",\n  \"klaviyoId\": \"0123456789ABCDEFGHIJKLMNOP\",\n  \"clientUserId\": \"123456\",\n  \"customIdentifiers\": [\n    {\n      \"name\": \"loyaltyId\",\n      \"value\": \"1122334455\"\n    },\n    {\n      \"name\": \"loyaltyId\",\n      \"value\": \"1122334455\"\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
