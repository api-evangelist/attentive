        {
          "id": "5879767d-15cd-4722-ae18-bfcf53d59e3d",
          "name": "Bulk User Attributes",
          "request": {
            "name": "Bulk User Attributes",
            "description": {
              "content": "This endpoint allows clients to submit multiple user attribute updates in bulk, accepting up to 256 payloads per request. Each request is validated, and a unique batch ID is returned for tracking the status of the batch.\n\nScopes Required: [attributes:all, subscriptions:all]\n\nDefault Rate Limit: 100 requests per second\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "bulk",
                "user",
                "attributes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"users\": [\n    {\n      \"attributes\": {\n        \"firstName\": \"<string>\",\n        \"lastName\": \"<string>\",\n        \"demographic\": {\n          \"language\": \"<string>\",\n          \"dateOfBirth\": \"<date>\",\n          \"age\": \"<integer>\",\n          \"organization\": \"<string>\",\n          \"title\": \"<string>\",\n          \"website\": \"<string>\"\n        },\n        \"location\": {\n          \"address1\": \"<string>\",\n          \"address2\": \"<string>\",\n          \"city\": \"<string>\",\n          \"state\": \"<string>\",\n          \"zip\": \"<string>\",\n          \"latitude\": \"<string>\",\n          \"longitude\": \"<string>\",\n          \"country\": \"<string>\",\n          \"region\": \"<string>\",\n          \"timezone\": \"<string>\"\n        },\n        \"locale\": {\n          \"language\": \"<string>\",\n          \"country\": \"<string>\"\n        },\n        \"custom\": {\n          \"key_0\": {}\n        }\n      },\n      \"subscriptions\": [\n        {\n          \"signUpSourceId\": \"<string>\",\n          \"channel\": \"<string>\",\n          \"singleOptIn\": \"<boolean>\"\n        },\n        {\n          \"signUpSourceId\": \"<string>\",\n          \"channel\": \"<string>\",\n          \"singleOptIn\": \"<boolean>\"\n        }\n      ],\n      \"identifiers\": {\n        \"email\": \"<string>\",\n        \"phone\": \"<string>\",\n        \"shopifyId\": \"<string>\",\n        \"klaviyoId\": \"<string>\",\n        \"clientUserId\": \"<string>\",\n        \"customIdentifiers\": [\n          {\n            \"key\": \"<string>\",\n            \"value\": \"<string>\"\n          },\n          {\n            \"key\": \"<string>\",\n            \"value\": \"<string>\"\n          }\n        ]\n      }\n    }\n  ]\n}",
