          "id": "5d4b4f1d-7cee-4f50-8339-ccd8c9e09c2a",
          "name": "Get Custom Attributes for a User",
          "request": {
            "name": "Get Custom Attributes for a User",
            "description": {
              "content": "Make a call to this endpoint to retrieve all custom attribute data associated with a user. You can query this endpoint by either phone or email.\n\n**Note: You must include a single query parameter, phone or email. Including both will result in a 400 error.**\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "attributes",
                "custom"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "phone",
                  "value": "<string>",
                  "description": "A user’s phone number in E.164 format. The '+' sign in the phone number must be encoded in the URL query parameter as '%2B'\n"
                },
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<string>",
                  "description": "A user's email\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "attributes:write subscriptions:write events:write ecommerce:write segments:write segments:read"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://api.attentivemobile.com/v1/authorization-codes/tokens"
                },
                {
                  "key": "authUrl",
                  "value": "https://ui-devel.attentivemobile.com/integrations/oauth-install?client_id={clientId}&redirect_uri={redirectUri}&scope={scope}"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
